# Copy to .env and fill in. Never commit the real .env file.

# The Odds API key (https://the-odds-api.com/)
ODDS_API_KEY=

# Odds API region — Australian bookmakers
ODDS_API_REGION=au

# Comma-separated bookmaker keys to keep. Confirmed live against
# /v4/sports/americanfootball_nfl/odds and .../events/{id}/odds with
# regions=au on 2026-09-27 — the `au` region currently returns 10 books for
# game lines (sportsbet, tab, ladbrokes_au, neds, betfair_ex_au, betr_au,
# betright, playup, pointsbetau, unibet), but player-prop coverage is much
# narrower and inconsistent event-to-event: sportsbet, pointsbetau, and
# unibet show up most often, tab/ladbrokes_au occasionally, tabtouch
# (a separate WA-specific TAB book, receptions only) sometimes, and
# neds/betfair_ex_au/betr_au/betright/playup showed no prop coverage at all
# in that check. Keep every AU book here for game lines and best-price
# search — a book with no prop coverage for a given event just won't
# contribute a quote, it doesn't hurt anything to include it.
ODDS_API_AU_BOOKMAKERS=sportsbet,tab,tabtouch,ladbrokes_au,neds,betfair_ex_au,betr_au,betright,playup,pointsbetau,unibet
