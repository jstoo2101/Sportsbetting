# Copy to .env and fill in. Never commit the real .env file.

# The Odds API key (https://the-odds-api.com/)
ODDS_API_KEY=

# Odds API region — Australian bookmakers
ODDS_API_REGION=au

# Comma-separated bookmaker keys to keep. Confirm current keys against
# https://the-odds-api.com/sports-odds-data/bookmaker-apis.html — this list
# is what The Odds API called them for the `au` region as of this build.
ODDS_API_AU_BOOKMAKERS=sportsbet,tab,ladbrokes_au,neds
